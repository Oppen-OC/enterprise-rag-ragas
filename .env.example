# ---------------------------------------------------------------------------
# Proveedor de LLM y embeddings.
#
# Por defecto apuntamos a Ollama, que expone una API compatible con OpenAI.
# Para cambiar de proveedor (OpenAI directo, o un gateway LiteLLM por delante)
# basta con tocar estas tres variables: ningun fichero .py conoce la URL.
#
#   OpenAI  -> OPENAI_BASE_URL=https://api.openai.com/v1
#   LiteLLM -> OPENAI_BASE_URL=http://localhost:4000/v1
# ---------------------------------------------------------------------------
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama

LLM_MODEL=qwen2.5:7b-instruct
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# ---------------------------------------------------------------------------
# Qdrant (levantado con docker-compose.yml)
# ---------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=enterprise_docs

# Numero de chunks que se recuperan por consulta.
TOP_K=4

# ---------------------------------------------------------------------------
# Recuperacion
#
#   dense   solo busqueda semantica
#   hybrid  semantica + BM25 fusionadas con RRF (tarea opcional 1 del enunciado)
# ---------------------------------------------------------------------------
RETRIEVAL_MODE=hybrid
PREFETCH_LIMIT=20
SPARSE_MODEL=Qdrant/bm25
